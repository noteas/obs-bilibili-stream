# Exclude everything
/*

# Except for default project files
!/third_party
!/AGENTS.md
!/GLOSSARY.md
!/docs
!/.github
!/build-aux
!/cmake
!/data
!/src
!/tests
!.clang-format
!.gersemirc
!.gitignore
!buildspec.json
!CMakeLists.txt
!CMakePresets.json
!com.obsproject.Studio.Plugin.BilibiliStream.metainfo.xml
!com.obsproject.Studio.Plugin.BilibiliStream.yaml
!flathub.json
!LICENSE
!README.md
!README_en.md

# Exclude lock files
*.lock.json

# Exclude macOS legacy resource forks
.DS_Store

# Exclude CMake build number cache
/cmake/.CMakeBuildNumber
re/

# CI/本地仿真:钉死 OBS 源码头面(cmake/linux/buildspec.cmake 解包目标)
.deps/
__pycache__/
